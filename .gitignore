#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build outputs
*.apk
*.aab
*.snap
*.so
*.zip
build/

# Secrets and API keys
assets/config/gemini_key.txt
*.env
.env.*

# User-specific files
*.user
*.userosscache
*.sln.docstates

# Sensitive files - API keys and passwords
lib/app/config/api_keys.dart
*.env
secrets.json

# Database files (local development)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Coverage
coverage/
*.lcov

